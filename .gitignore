# ==========================================================
# NLP-Research — Root .gitignore
# ==========================================================

# =========================
# Secrets / API keys
# =========================
.env
.env.*
!.env.example

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/

# =========================
# Python cache
# =========================
__pycache__/
*.py[cod]
*.pyc
*.pyo

# =========================
# Testing / tooling cache
# =========================
.pytest_cache/
.mypy_cache/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Shared data (~21 GB on disk incl. hardlinks) — never commit
# data/raw/        : COCO 2014 + RefCOCO downloads (read-only)
# data/processed/  : CSVs written by notebook 02
# data/yolo_dataset: image hardlinks + YOLO labels (regenerated by train.py)
# =========================
data/

# =========================
# Module 2 (vision) — generated artifacts
# runs/        : Ultralytics training output (weights, curves). Paper copies
#                of the curves/metrics live in research/experiments/.
# test_output/ : annotated images from test_model.py
# notebooks/outputs/ : figures written when notebooks are re-run
#                      (curated copies live in research/dataset/)
# weights/     : pretrained base weights (yolov8n.pt etc.)
# =========================
module2_vision/training/runs/
module2_vision/training/test_output/
module2_vision/notebooks/outputs/
module2_vision/weights/

# Exception: keep the human-readable results (small, needed for paper)
!module2_vision/training/results_summary.txt

# =========================
# Items staged for deletion review (tracked files inside stay tracked)
# =========================
_to_delete/

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Audio files (large / personal recordings)
# Evaluation audio samples are small and required for
# reproducibility — kept via explicit exception below.
# =========================
*.wav
*.mp3
*.flac

# Exception: small evaluation benchmark WAV recordings
# (10 × ~160 KB = ~1.6 MB total — required to reproduce results)
!module1_audio/evaluation/audio/*.wav

# =========================
# ML model / checkpoint files
# =========================
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors

# =========================
# OS / Editor artefacts
# =========================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/