# Environment variables — names only, no values.
# ─────────────────────────────────────────────────────────────
# Copy to .env (project root) and fill in the values:
#   copy .env.example .env
# Never commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Read from .env by module1_audio (speech recognition).
# Get a key at https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# ── Optional overrides ───────────────────────────────────────
# These are read from the shell environment (not from .env), e.g.
#   $env:DATA_DIR = "E:\datasets\nlp-research"   (PowerShell)
#
# DATA_DIR=             shared data folder (default: <project root>/data)
# YOLO_MODEL_PATH=      detector weights (default: module2_vision/training/runs/train/weights/best.pt)
# Every tunable in module2_vision/config/config.py and
# module1_audio/audio_feedback/tts_config.py can be overridden the same way.
